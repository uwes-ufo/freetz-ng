echo_freetz_ng(){
	cat << EOX
   _____              _            _   _  ____
  |  ___| __ ___  ___| |_ ____    | \ | |/ ___|
  | |_ | '__/ _ \/ _ \ __|_  /____|  \| | |  _
  |  _|| | |  __/  __/ |_ / /_____| |\  | |_| |
  |_|  |_|  \___|\___|\__/___|    |_| \_|\____|
EOX
}
echo_toaster(){
	echo -e "\e[33m"
	cat << EOX
    _|__  ___   ___   ___ _|__  ___   ___
     |   /   \  ___| (___  |   /___) |   \ 
      \_ \___/ (___| ____)  \_ \___  |
EOX
	echo -e "\e[0m"
}
echo_booster(){
	echo -e "\e[35m"
	cat << EOX
    |__   ___   ___   ___ _|__  ___   ___
    |  \ /   \ /   \ (___  |   /___) |   \ 
   _|__/ \___/ \___/ ____)  \_ \___  |
EOX
	echo -e "\e[0m"
}
echo_ancestor(){
	echo -e "\e[34m"
	cat << EOX
     ___   ___   ___  ___   ___ _|__  ___   ___
     ___| |   | /    /___) (___  |   /   \ |   \ 
    (___| |   | \___ \___  ____)  \_ \___/ |
EOX
	echo -e "\e[0m"
}

echo -n 'Welcome at '
hostname
uname -a
echo
case $(hostname) in
	ancestor)	echo_ancestor	;;
	booster)	echo_booster	;;
	toaster)	echo_toaster	;;
	*)			echo_freetz_ng	;;
esac
