if [ "$EXTERNAL_FREETZ_PACKAGE_PYTHON" == "y" ] ; then
	EXTERNAL_FILES+=" /usr/bin/python3.12.bin /usr/include/python3.12 /usr/lib/python3.12"
	[ "$FREETZ_PACKAGE_PYTHON_COMPRESS_PYC" == "y" ] && EXTERNAL_FILES+=" /usr/lib/python312.zip"
fi

[ "$EXTERNAL_FREETZ_LIB_libpython2" == "y" ] && EXTERNAL_FILES+=" ${FREETZ_LIBRARY_DIR}/libpython3.12.so.1.0"
