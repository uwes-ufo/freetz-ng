--- 5690_Pro-alder-08.01/sources/hui/module/connect/connect_methode7.c	2024-12-11 16:20:10.000000000 +0100
+++ 5690_Pro-alder-08.03/sources/hui/module/connect/connect_methode7.c	2025-01-29 12:29:01.000000000 +0100
@@ -6,12 +6,14 @@
 #include <avm/hui/events.h>
 
 static bool methode7_ap_mode = false;
+static bool methode7_wait_completed = false;
 
 static void methode7_init(enum connect_event new_state __maybe_unused) {
-
     if (wlan_on == 0) {
         wlan_on = 1;
         state_machine_queue_trigger_event(connect_event_turn_wlan_on);
+    } else if (is_wlan_configuring() && !methode7_wait_completed) {
+        state_machine_queue_trigger_event(connect_event_wlan_configuring);
     } else if (is_nexus_master() || access != access_type_wlan_bridge || uplink != wlan_uplink_down) {
         methode7_ap_mode = true;
         state_machine_queue_trigger_event(connect_event_uplink_other);
@@ -19,6 +21,17 @@
         methode7_ap_mode = false;
         state_machine_queue_trigger_event(connect_event_uplink_wlan_bridge_down);
     }
+
+    methode7_wait_completed = false;
+}
+
+static void methode7_post_wait_wlan_on(enum connect_event new_state) {
+    /* Wlan should now be active but the state is not updated until later...
+     * For this reason we give the init state a hint to check if we waited
+     * for wlan.
+     */
+    if (new_state == connect_event_boot_complete)
+        methode7_wait_completed = true;
 }
 
 static void methode7_post_nexus_check(enum connect_event new_state __maybe_unused) {
@@ -37,6 +50,7 @@
         .pre_button_events = {
             avm_event_push_button_nexus_pairing_off,
         },
+        .post_func = methode7_post_wait_wlan_on,
         .transitions = {
             /* timeout -> fail with timeout */
             {.event = connect_event_timeout, .next_state = connect_state_timeout},
